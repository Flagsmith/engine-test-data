  "context": {
    "environment": {
      "key": "key",
      "name": "Environment"
    },
    "identity": {
      "identifier": "high_scorer",
      "key": "key_high_scorer",
      "traits": {
        "score": 95
      }
    },
    "segments": {
      "1": {
        "key": "1",
        "name": "non_threshold_scorers_segment",
        "rules": [
          {
            "type": "ALL",
            "conditions": [
              {
                "operator": "NOT_EQUAL",
                "property": "score",
                "value": "90.5"
              }
            ]
          }
        ]
      }
    }
  },
  "result": {
    "flags": {},
    "segments": []
  }
