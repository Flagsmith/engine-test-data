{
  // Given: A feature `a` overridden by two segments — `a_requires_a` is
  //        conditioned on `a` itself, closing a cycle, and `everyone` matches
  //        unconditionally
  // When: The context is evaluated
  // Then: `a` serves `everyone`'s override, reported as a circular
  //       dependency, and only `everyone` matches
  //
  // NOTE: Only the segment that closes the cycle is discarded; other segments
  //       overriding the flag still apply. The error reason is what signals
  //       that the flag could not be fully resolved, so its served state and
  //       value carry no guarantee beyond the segments that did match.
  "$schema": "https://raw.githubusercontent.com/Flagsmith/engine-test-data/refs/tags/v2.0.0/schema.json",
  "context": {
    "environment": {
      "key": "key",
      "name": "Environment"
    },
    "features": {
      "a": {
        "key": "1",
        "name": "a",
        "enabled": false,
        "value": "a_default"
      }
    },
    "segments": {
      "1": {
        "key": "1",
        "name": "a_requires_a",
        "rules": [
          {
            "type": "ALL",
            "conditions": [
              {
                "operator": "EQUAL",
                "property": "$.flags.a.enabled",
                "value": "true"
              }
            ]
          }
        ],
        "overrides": [
          {
            "key": "1",
            "name": "a",
            "enabled": true,
            "value": "a_cyclic_override"
          }
        ]
      },
      "2": {
        "key": "2",
        "name": "everyone",
        "rules": [
          {
            "type": "ALL",
            "conditions": [
              {
                "operator": "EQUAL",
                "property": "$.environment.name",
                "value": "Environment"
              }
            ]
          }
        ],
        "overrides": [
          {
            "key": "1",
            "name": "a",
            "enabled": true,
            "value": "a_everyone_override"
          }
        ]
      }
    }
  },
  "result": {
    "flags": {
      "a": {
        "enabled": true,
        "name": "a",
        "reason": "ERROR; code=CIRCULAR_DEPENDENCY",
        "value": "a_everyone_override",
        "variant": null
      }
    },
    "segments": [
      {
        "name": "everyone"
      }
    ]
  }
}
