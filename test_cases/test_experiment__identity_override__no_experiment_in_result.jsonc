// Given: A feature in a running experiment, and an identity in its rollout segment
//        with an identity override for the feature
// When: The identity is evaluated
// Then: The identity override wins, so the flag carries no experiment
{
  "$schema": "https://raw.githubusercontent.com/Flagsmith/engine-test-data/refs/tags/v2.0.0/schema.json",
  "context": {
    "environment": {
      "key": "exp_env",
      "name": "Production"
    },
    "identity": {
      "identifier": "user_123",
      "key": "exp_env_user_123"
    },
    "features": {
      "checkout": {
        "key": "100",
        "name": "checkout",
        "enabled": true,
        "value": "control",
        "metadata": {
          "id": 1,
          "experiment": {
            "id": 7,
            "name": "checkout experiment",
            "in_experiment": false
          }
        }
      }
    },
    "segments": {
      "42": {
        "key": "42",
        "name": "checkout experiment rollout",
        "rules": [
          {
            "type": "ALL",
            "conditions": [
              {
                "property": "$.identity.key",
                "operator": "PERCENTAGE_SPLIT",
                "value": "100"
              }
            ]
          }
        ],
        "overrides": [
          {
            "key": "101",
            "name": "checkout",
            "enabled": true,
            "value": "control",
            "priority": 0,
            "variants": [
              {
                "key": "treatment",
                "value": "hello treatment",
                "weight": 100,
                "priority": 1
              }
            ],
            "metadata": {
              "id": 1,
              "experiment": {
                "id": 7,
                "name": "checkout experiment",
                "in_experiment": true
              }
            }
          }
        ]
      },
      "identity_overrides": {
        "key": "identity_overrides",
        "name": "identity_overrides",
        "rules": [
          {
            "type": "ALL",
            "conditions": [
              {
                "property": "$.identity.identifier",
                "operator": "IN",
                "value": ["user_123"]
              }
            ]
          }
        ],
        "overrides": [
          {
            "key": "",
            "name": "checkout",
            "enabled": true,
            "value": "hello override",
            "priority": -1,
            "metadata": {
              "id": 1
            }
          }
        ],
        "metadata": {
          "source": "identity_overrides"
        }
      }
    }
  },
  "result": {
    "flags": {
      "checkout": {
        "enabled": true,
        "name": "checkout",
        "reason": "TARGETING_MATCH; segment=identity_overrides",
        "value": "hello override",
        "variant": null,
        "metadata": {
          "id": 1
        }
      }
    },
    "segments": [
      {
        "name": "checkout experiment rollout"
      },
      {
        "name": "identity_overrides",
        "metadata": {
          "source": "identity_overrides"
        }
      }
    ]
  }
}
